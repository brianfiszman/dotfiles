 -- compatibility shim for breaking change on nightly/0.11
 local opts = vim.fn.has "nvim-0.10" == 1 and { force = true, all = false } or true
 
+-- Neovim 0.12 always returns a list of nodes for each query capture.
+-- The legacy nvim-treesitter predicates were registered with all=false and
+-- expect one node, so preserve the old behavior by unwrapping the last node.
+local function get_node(match, id)
+  local captured = match[id]
+  if type(captured) == "table" then
+    return captured[#captured]
+  end
+  return captured
+end
